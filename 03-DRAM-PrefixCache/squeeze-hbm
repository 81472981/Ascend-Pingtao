#!/usr/bin/env bash
"${PYTHON:-python3}" - <<'PY'
import json, os, re, shlex, shutil, subprocess, sys, time, urllib.request
from datetime import datetime, timedelta, timezone
from pathlib import Path

HOST, PORT = "127.0.0.1", 8000
MODEL = os.environ.get("VB_MODEL") or None
SERVED_MODEL_NAME = os.environ.get("VB_SERVED_MODEL_NAME") or None
TOKENIZER = os.environ.get("VB_TOKENIZER") or None
VLLM_BIN = os.environ.get("VLLM_BIN", "vllm")

# ====== Config ======
INPUT_LEN = 16 * 1024
SQUEEZE_TOTAL = int(os.environ.get("VB_SQUEEZE", "200"))
SQUEEZE_BATCH = int(os.environ.get("VB_SQUEEZE_BATCH", "10"))
SQUEEZE_CONC = int(os.environ.get("VB_SQUEEZE_CONC", "10"))
GPU_TARGET = float(os.environ.get("VB_GPU_TARGET", "95"))

def vllm():
    parts = shlex.split(VLLM_BIN)
    exe = parts[0]
    if os.path.dirname(exe) and not os.path.isfile(exe):
        sys.exit(f"vllm not found: {exe}")
    if not os.path.dirname(exe) and shutil.which(exe) is None:
        exe = str((Path(".venv/bin") / exe).resolve())
        if not os.path.isfile(exe):
            sys.exit(f"vllm not found: {parts[0]}")
        parts[0] = exe
    return parts

def server_model_info():
    try:
        data = json.loads(urllib.request.urlopen(f"http://{HOST}:{PORT}/v1/models", timeout=2).read().decode())
        models = data.get("data") or []
        if models:
            return models[0].get("id"), models[0].get("root")
    except Exception:
        pass
    return None, None

def discover_model():
    global MODEL, SERVED_MODEL_NAME, TOKENIZER
    if MODEL is not None and SERVED_MODEL_NAME is not None and TOKENIZER is not None:
        return
    served_name, root = server_model_info()
    if MODEL is None:
        MODEL = root or served_name
    if SERVED_MODEL_NAME is None:
        SERVED_MODEL_NAME = served_name or MODEL
    if TOKENIZER is None and MODEL:
        candidate = Path(MODEL).expanduser()
        if candidate.is_dir():
            TOKENIZER = str(candidate)

def bench_cmd(num_prompts, max_concurrency, seed, num_prefixes, filename):
    cmd = [
        *vllm_bin, "bench", "serve", "--host", HOST, "--port", str(PORT),
        "--endpoint", "/v1/completions", "--backend", "openai",
        "--dataset-name", "prefix_repetition", "--num-prompts", str(num_prompts),
        "--max-concurrency", str(max_concurrency), "--request-rate", "inf",
        "--prefix-repetition-prefix-len", str(INPUT_LEN),
        "--prefix-repetition-suffix-len", "0",
        "--prefix-repetition-num-prefixes", str(num_prefixes),
        "--prefix-repetition-output-len", "1", "--seed", str(seed),
        "--disable-shuffle", "--temperature", "0", "--ignore-eos",
        "--save-result", "--save-detailed",
        "--result-dir", str(json_dir), "--result-filename", filename,
    ]
    extras = []
    if MODEL:
        extras += ["--model", MODEL]
    if SERVED_MODEL_NAME:
        extras += ["--served-model-name", SERVED_MODEL_NAME]
    if TOKENIZER:
        extras += ["--tokenizer", TOKENIZER]
    return cmd + extras

def run(cmd):
    subprocess.run(cmd, text=True, capture_output=True)

def metric_val(text, name):
    for line in text.splitlines():
        fields = line.split()
        if len(fields) >= 2 and fields[0].split("{", 1)[0] == name:
            try:
                return float(fields[1])
            except ValueError:
                pass
    return None

def get_metrics():
    try:
        return urllib.request.urlopen(f"http://{HOST}:{PORT}/metrics", timeout=2).read().decode()
    except Exception:
        return ""

def snapshot():
    m = get_metrics()
    preempt = metric_val(m, "vllm:num_preemptions_total")
    gpu = None
    for name in ("vllm:gpu_cache_usage_perc", "vllm:gpu_prefix_cache_usage_perc"):
        gpu = metric_val(m, name)
        if gpu is not None:
            break
    return preempt, gpu

def swapped_tokens(m):
    """Return number of tokens currently swapped to CPU, or None if unavailable."""
    for name in ("vllm:num_swapped_tokens", "vllm:cpu_cache_usage_perc",
                 "vllm:num_cpu_blocks_used", "vllm:num_preempted_tokens"):
        val = metric_val(m, name)
        if val is not None:
            return val, name
    return None, None

def verify_dram():
    """
    Reliable DRAM detection: send prefix P request, check if swapped tokens decreased.
    If swapped_tokens drops after serving P -> P's blocks were in DRAM and got swapped back.
    """
    m_before = get_metrics()
    swapped_before, swapped_name = swapped_tokens(m_before)
    preempt_before = metric_val(m_before, "vllm:num_preemptions_total")

    run(bench_cmd(1, 1, 0, 1, "verify.json"))

    m_after = get_metrics()
    swapped_after, _ = swapped_tokens(m_after)
    preempt_after = metric_val(m_after, "vllm:num_preemptions_total")

    # Read TTFT
    try:
        data = json.loads((json_dir / "verify.json").read_text())
        ttft = float(data["ttfts"][0]) if data.get("ttfts") else None
    except Exception:
        ttft = None

    # Build info string
    parts = []
    if ttft is not None:
        parts.append(f"TTFT={ttft:.4f}s")
    if preempt_before is not None and preempt_after is not None:
        parts.append(f"preemptions={preempt_before:.0f}->{preempt_after:.0f}")
    if swapped_before is not None and swapped_after is not None:
        parts.append(f"{swapped_name}={swapped_before:.0f}->{swapped_after:.0f}")

    # Core logic: if swapped tokens decreased, prefix P was in DRAM
    if swapped_before is not None and swapped_after is not None:
        if swapped_before > 0 and swapped_after < swapped_before:
            return True, f"DRAM confirmed (swapped tokens dropped: {swapped_before:.0f} -> {swapped_after:.0f}) | " + " | ".join(parts)
        elif swapped_before > 0:
            return False, f"Swapped tokens unchanged ({swapped_before:.0f}) - prefix P may still be in HBM | " + " | ".join(parts)
        else:
            return False, f"No swapped tokens (0) - nothing in DRAM | " + " | ".join(parts)

    # Fallback: if no swapped metrics, check preemptions + GPU
    _, gpu = snapshot()
    if preempt_after is not None and preempt_before is not None:
        if preempt_after > preempt_before and gpu is not None and gpu >= GPU_TARGET:
            return True, f"Likely DRAM (preemptions +{preempt_after-preempt_before:.0f}, GPU={gpu:.1f}%) | " + " | ".join(parts)
    return False, "Cannot confirm DRAM (no swap metrics) | " + " | ".join(parts)

# --- Main ---
vllm_bin = vllm()
discover_model()
json_dir = Path("vbench-squeeze") / datetime.now(timezone(timedelta(hours=8))).strftime("%Y%m%d-%H%M%S")
json_dir.mkdir(parents=True, exist_ok=True)

print(f"Model: {MODEL}")
print(f"Input len: {INPUT_LEN} tokens")
print(f"Squeeze: up to {SQUEEZE_TOTAL} requests, batch={SQUEEZE_BATCH}, concurrency={SQUEEZE_CONC}")
print(f"Target: GPU cache >= {GPU_TARGET}%")
print()

# Step 1: Warmup
print("[1/4] Warmup: establishing KV cache in HBM...")
run(bench_cmd(1, 1, 0, 1, "warmup.json"))
try:
    warmup_data = json.loads((json_dir / "warmup.json").read_text())
    baseline_ttft = float(warmup_data["ttfts"][0]) if warmup_data.get("ttfts") else None
    print(f"  Warmup done. Baseline TTFT: {baseline_ttft:.4f}s" if baseline_ttft else "  Warmup done.")
except Exception:
    baseline_ttft = None
    print("  Warmup done.")

# Step 2: Squeeze loop
print(f"\n[2/4] Squeezing HBM (until GPU cache >= {GPU_TARGET}% or {SQUEEZE_TOTAL} requests)...")
print(f"{'Batch':<8}{'Sent':<10}{'Preemptions':<16}{'GPU Cache':<14}{'Status'}")
print("-" * 62)

preempt_start, gpu_start = snapshot()
total_sent = 0
preempt_last = preempt_start or 0
batch_num = 0

while total_sent < SQUEEZE_TOTAL:
    batch_num += 1
    batch_count = min(SQUEEZE_BATCH, SQUEEZE_TOTAL - total_sent)
    seed = batch_num
    run(bench_cmd(batch_count, min(SQUEEZE_CONC, batch_count), seed, batch_count, f"squeeze-{batch_num:03d}.json"))
    total_sent += batch_count

    preempt, gpu = snapshot()
    preempt_str = f"{preempt_last:.0f} -> {preempt:.0f}" if preempt is not None else "N/A"
    gpu_str = f"{gpu:.1f}%" if gpu is not None else "N/A"
    preempt_delta = (preempt or 0) - preempt_last
    preempt_last = preempt or 0

    if gpu is not None and gpu >= GPU_TARGET:
        status = "FULL \u2713"
        print(f"  {batch_num:<6}{total_sent:<10}{preempt_str:<16}{gpu_str:<14}{status}")
        break
    elif preempt_delta > 0:
        status = "swapping"
    else:
        status = "filling"

    print(f"  {batch_num:<6}{total_sent:<10}{preempt_str:<16}{gpu_str:<14}{status}")

preempt_final, gpu_final = snapshot()
print(f"\n  Sent {total_sent} requests. Preemptions: {preempt_final:.0f}, GPU cache: {gpu_final:.1f}%"
      if preempt_final is not None and gpu_final is not None else f"\n  Sent {total_sent} requests.")

# Step 3: Verify DRAM via swapped tokens delta
print(f"\n[3/4] Verifying: sending prefix P, checking if swapped tokens drop...")
print(f"  (If swapped_tokens decreases after request, P's blocks were in DRAM and got swapped back)")
is_dram, msg = verify_dram()
print(f"  {msg}")

# Step 4: Retry if not confirmed
retries = 0
while not is_dram and retries < 2 and total_sent < SQUEEZE_TOTAL * 3:
    retries += 1
    extra = SQUEEZE_TOTAL // 2
    print(f"\n[4/4] Not confirmed. Squeezing {extra} more (retry {retries}/2)...")
    for i in range(max(extra // SQUEEZE_BATCH, 1)):
        batch_count = min(SQUEEZE_BATCH, extra - i * SQUEEZE_BATCH)
        if batch_count <= 0:
            break
        seed = batch_num + i + retries * 1000
        run(bench_cmd(batch_count, min(SQUEEZE_CONC, batch_count), seed, batch_count, f"squeeze-r{retries}-{i:03d}.json"))
        total_sent += batch_count
    preempt_final, gpu_final = snapshot()
    print(f"  Sent {total_sent} total. Preemptions: {preempt_final:.0f}, GPU: {gpu_final:.1f}%"
          if preempt_final is not None and gpu_final is not None else f"  Sent {total_sent} total.")
    is_dram, msg = verify_dram()
    print(f"  {msg}")

print(f"\nFinal: {'DRAM confirmed' if is_dram else 'DRAM NOT confirmed - may need more squeeze'}")
print(f"Total requests sent: {total_sent}")
print(f"Run: bash bench-dram")
PY
