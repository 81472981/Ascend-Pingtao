#!/usr/bin/env bash
export VB_STAGE="R1-warmup"
"${PYTHON:-python3}" - <<'PY'
import json, os, re, shlex, shutil, statistics, subprocess, sys, time, urllib.request, zipfile
from datetime import datetime, timedelta, timezone
from pathlib import Path
from xml.sax.saxutils import escape

STAGE = os.environ["VB_STAGE"]
HOST = os.environ.get("VB_HOST", "127.0.0.1")
PORT = int(os.environ.get("VB_PORT", "8000"))
INPUT_LEN = int(os.environ.get("VB_INPUT_LEN", str(16 * 1024)))
BATCHES = int(os.environ.get("VB_BATCHES", "5"))
CONCURRENCIES = [int(x) for x in os.environ.get("VB_CONCURRENCIES", "1,5,10").split(",") if x.strip()]
MIN_HIT_RATE = float(os.environ.get("VB_MIN_HIT_RATE", "0.95"))
MAX_LOCAL_HIT_RATE = float(os.environ.get("VB_MAX_LOCAL_HIT_RATE", "0.05"))
STORE_SETTLE_SECONDS = float(os.environ.get("VB_STORE_SETTLE_SECONDS", "2"))
STRICT = os.environ.get("VB_STRICT", "1").lower() not in ("0", "false", "no")
VLLM_BIN = os.environ.get("VLLM_BIN", "vllm")
MODEL = os.environ.get("VB_MODEL") or None
SERVED_MODEL_NAME = os.environ.get("VB_SERVED_MODEL_NAME") or None
TOKENIZER = os.environ.get("VB_TOKENIZER") or None
RUN_DIR = Path(os.environ.get("VB_RUN_DIR", "vbench-results/dram-session"))
JSON_DIR = RUN_DIR / "json" / STAGE
MOONCAKE_URL = os.environ.get("VB_MOONCAKE_METRICS_URL", "http://127.0.0.1:9003/metrics/summary")
MOONCAKE_CONFIG = Path(os.environ.get("MOONCAKE_CONFIG_PATH", "/tmp/mooncake.json"))
XML_INVALID = re.compile(r"[\x00-\x08\x0B\x0C\x0E-\x1F\uFFFE\uFFFF]")

CACHE_PAIRS = {
    "local": (
        ("vllm:prefix_cache_queries_total", "vllm:prefix_cache_hits_total"),
        ("vllm:prefix_cache_queries", "vllm:prefix_cache_hits"),
    ),
    "external": (
        ("vllm:external_prefix_cache_queries_total", "vllm:external_prefix_cache_hits_total"),
        ("vllm:external_prefix_cache_queries", "vllm:external_prefix_cache_hits"),
    ),
}

def fetch(url, timeout=5):
    return urllib.request.urlopen(url, timeout=timeout).read().decode("utf-8", "replace")

def model_info():
    try:
        data = json.loads(fetch(f"http://{HOST}:{PORT}/v1/models"))
        item = (data.get("data") or [])[0]
        return item.get("id"), item.get("root")
    except Exception:
        return None, None

def discover_model():
    global MODEL, SERVED_MODEL_NAME, TOKENIZER
    served, root = model_info()
    MODEL = MODEL or root or served
    SERVED_MODEL_NAME = SERVED_MODEL_NAME or served or MODEL
    if TOKENIZER is None and MODEL and Path(MODEL).expanduser().is_dir():
        TOKENIZER = str(Path(MODEL).expanduser())
    if not MODEL:
        sys.exit("cannot discover model; set VB_MODEL and VB_SERVED_MODEL_NAME")

def vllm_command():
    parts = shlex.split(VLLM_BIN)
    exe = parts[0]
    if not os.path.dirname(exe) and shutil.which(exe) is None:
        candidate = Path(".venv/bin") / exe
        if candidate.is_file():
            parts[0] = str(candidate.resolve())
        else:
            sys.exit(f"vllm not found: {exe}")
    elif os.path.dirname(exe) and not Path(exe).is_file():
        sys.exit(f"vllm not found: {exe}")
    return parts

def metric_sum(text, name):
    values = []
    for line in text.splitlines():
        fields = line.split()
        if len(fields) >= 2 and fields[0].split("{", 1)[0] == name:
            try:
                values.append(float(fields[1]))
            except ValueError:
                pass
    return sum(values) if values else None

def cache_metrics():
    try:
        text = fetch(f"http://{HOST}:{PORT}/metrics")
    except Exception:
        return {name: None for name in CACHE_PAIRS}
    result = {}
    for label, pairs in CACHE_PAIRS.items():
        result[label] = None
        for query_name, hit_name in pairs:
            queries, hits = metric_sum(text, query_name), metric_sum(text, hit_name)
            if queries is not None and hits is not None:
                result[label] = (queries, hits)
                break
    return result

def cache_delta(before, after):
    result = {}
    for label in CACHE_PAIRS:
        b, a = before.get(label), after.get(label)
        if b is None or a is None:
            result[label] = None
            continue
        queries, hits = a[0] - b[0], a[1] - b[1]
        result[label] = {"queries": queries, "hits": hits, "rate": hits / queries if queries > 0 else None}
    return result

def rate(value):
    return f"{value:.2%}" if value is not None else "N/A"

def mooncake_summary():
    try:
        return fetch(MOONCAKE_URL).strip()
    except Exception:
        return ""

def mooncake_keys(summary):
    match = re.search(r"Keys:\s*(\d+)", summary, re.IGNORECASE)
    return int(match.group(1)) if match else None

def reset_local():
    before = mooncake_keys(mooncake_summary())
    url = f"http://{HOST}:{PORT}/reset_prefix_cache?reset_running_requests=false&reset_connector=false"
    request = urllib.request.Request(url, data=b"", method="POST")
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            body = response.read().decode("utf-8", "replace").strip()
            if response.status != 200 or body.lower() in ("false", "0"):
                raise RuntimeError(f"HTTP {response.status}: {body}")
    except Exception as error:
        raise RuntimeError("local cache reset failed; start vLLM with VLLM_SERVER_DEV_MODE=1") from error
    after = mooncake_keys(mooncake_summary())
    if before is not None and after != before:
        raise RuntimeError(f"Mooncake Keys changed during local reset: {before} -> {after}")
    return f"HTTP 200, Mooncake Keys {before} -> {after}"

def verify_stage_preconditions():
    metrics = cache_metrics()
    if metrics["local"] is None or metrics["external"] is None:
        sys.exit("local/external prefix-cache counters are unavailable on /metrics")
    keys = mooncake_keys(mooncake_summary())
    if STAGE == "R1-warmup":
        if keys is None and STRICT:
            sys.exit(f"cannot read Mooncake Keys from {MOONCAKE_URL}")
        if keys not in (None, 0):
            sys.exit(f"R1 requires empty Mooncake, but Keys={keys}; restart Mooncake and vLLM")
        print(f"Initial reset: {reset_local()}")
    else:
        if keys is None or keys <= 0:
            sys.exit(f"{STAGE} requires P1 in Mooncake; run R1-warmup first")
    if STAGE == "R3-dram-cache":
        if not MOONCAKE_CONFIG.is_file():
            sys.exit(f"Mooncake config not found: {MOONCAKE_CONFIG}")
        config = json.loads(MOONCAKE_CONFIG.read_text(encoding="utf-8"))
        if config.get("enable_ssd_offload"):
            sys.exit("SSD offload is enabled; result cannot be labelled DRAM-only")

def command(vllm, concurrency, batch, filename):
    cmd = [
        *vllm, "bench", "serve", "--host", HOST, "--port", str(PORT),
        "--endpoint", "/v1/completions", "--backend", "openai",
        "--dataset-name", "prefix_repetition", "--num-prompts", str(concurrency),
        "--max-concurrency", str(concurrency), "--request-rate", "inf",
        "--prefix-repetition-prefix-len", str(INPUT_LEN),
        "--prefix-repetition-suffix-len", "0", "--prefix-repetition-num-prefixes", "1",
        "--prefix-repetition-output-len", "1", "--seed", "0", "--disable-shuffle",
        "--temperature", "0", "--ignore-eos", "--save-result", "--save-detailed",
        "--result-dir", str(JSON_DIR), "--result-filename", filename,
    ]
    if MODEL:
        cmd += ["--model", MODEL]
    if SERVED_MODEL_NAME:
        cmd += ["--served-model-name", SERVED_MODEL_NAME]
    if TOKENIZER:
        cmd += ["--tokenizer", TOKENIZER]
    return cmd

def run_command(cmd):
    result = subprocess.run(cmd, text=True, capture_output=True)
    if result.returncode:
        sys.exit(f"vllm bench failed: {shlex.join(cmd)}\n{result.stderr[-3000:]}")

def source_name(delta):
    local = delta["local"] and delta["local"]["rate"]
    external = delta["external"] and delta["external"]["rate"]
    if local is not None and local >= MIN_HIT_RATE:
        return "HBM"
    if external is not None and external >= MIN_HIT_RATE:
        return "DRAM"
    return "MISS_OR_MIXED"

def validate(delta, completed, expected):
    if completed != expected:
        return False, f"request success {completed}/{expected}"
    if STAGE == "R1-warmup":
        return True, "population stage; only the first P1 is guaranteed cold"
    if delta["local"] is None or delta["external"] is None:
        return False, "cache counters unavailable"
    local, external = delta["local"]["rate"], delta["external"]["rate"]
    if STAGE == "R2-hbm-cache":
        return (local is not None and local >= MIN_HIT_RATE,
                f"local={rate(local)}, required >= {MIN_HIT_RATE:.0%}")
    valid = (local is not None and local <= MAX_LOCAL_HIT_RATE and
             external is not None and external >= MIN_HIT_RATE)
    return valid, (f"local={rate(local)} (<= {MAX_LOCAL_HIT_RATE:.0%}), "
                   f"external={rate(external)} (>= {MIN_HIT_RATE:.0%})")

def col_name(index):
    name = ""
    while index >= 0:
        name = chr(65 + index % 26) + name
        index = index // 26 - 1
    return name

def sheet_xml(rows):
    body = []
    for row_no, row in enumerate(rows, 1):
        cells = []
        for col_no, value in enumerate(row):
            ref = f"{col_name(col_no)}{row_no}"
            if isinstance(value, (int, float)) and not isinstance(value, bool):
                cells.append(f'<c r="{ref}"><v>{value}</v></c>')
            else:
                text = escape(XML_INVALID.sub("", str(value)))
                cells.append(f'<c r="{ref}" t="inlineStr"><is><t>{text}</t></is></c>')
        body.append(f'<row r="{row_no}">{"".join(cells)}</row>')
    return '<?xml version="1.0" encoding="UTF-8" standalone="yes"?><worksheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main"><sheetData>' + "".join(body) + '</sheetData></worksheet>'

def write_xlsx(path, sheets):
    content = '<?xml version="1.0" encoding="UTF-8" standalone="yes"?><Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types"><Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/><Default Extension="xml" ContentType="application/xml"/><Override PartName="/xl/workbook.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml"/>'
    rels = '<?xml version="1.0" encoding="UTF-8" standalone="yes"?><Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">'
    sheet_tags = ""
    for index, name in enumerate(sheets, 1):
        content += f'<Override PartName="/xl/worksheets/sheet{index}.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml"/>'
        rels += f'<Relationship Id="rId{index}" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/worksheet" Target="worksheets/sheet{index}.xml"/>'
        sheet_tags += f'<sheet name="{escape(name)}" sheetId="{index}" r:id="rId{index}"/>'
    content += '</Types>'
    rels += '</Relationships>'
    workbook = f'<?xml version="1.0" encoding="UTF-8" standalone="yes"?><workbook xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships"><sheets>{sheet_tags}</sheets></workbook>'
    root_rels = '<?xml version="1.0" encoding="UTF-8" standalone="yes"?><Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships"><Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument" Target="xl/workbook.xml"/></Relationships>'
    with zipfile.ZipFile(path, "w", zipfile.ZIP_DEFLATED) as archive:
        archive.writestr("[Content_Types].xml", content)
        archive.writestr("_rels/.rels", root_rels)
        archive.writestr("xl/workbook.xml", workbook)
        archive.writestr("xl/_rels/workbook.xml.rels", rels)
        for index, rows in enumerate(sheets.values(), 1):
            archive.writestr(f"xl/worksheets/sheet{index}.xml", sheet_xml(rows))

RUN_DIR.mkdir(parents=True, exist_ok=True)
JSON_DIR.mkdir(parents=True, exist_ok=True)
discover_model()
verify_stage_preconditions()
vllm = vllm_command()
raw_rows = [["concurrency", "batch", "request_index", "ttft_seconds", "input_tokens",
             "output_tokens", "output_text", "valid_batch", "source", "error", "result_file"]]
validation_rows = [["concurrency", "batch", "completed", "failed", "local_queries",
                    "local_hits", "local_rate", "external_queries", "external_hits",
                    "external_rate", "source", "valid", "reason", "reset_evidence"]]
valid_values = {concurrency: [] for concurrency in CONCURRENCIES}
invalid = []

print(f"Stage={STAGE}; model={MODEL}; run_dir={RUN_DIR}")
for concurrency in CONCURRENCIES:
    for batch in range(1, BATCHES + 1):
        reset_evidence = reset_local() if STAGE == "R3-dram-cache" else ""
        filename = f"c{concurrency:03d}-b{batch:02d}.json"
        before = cache_metrics()
        run_command(command(vllm, concurrency, batch, filename))
        data = json.loads((JSON_DIR / filename).read_text(encoding="utf-8"))
        after = cache_metrics()
        delta = cache_delta(before, after)
        errors, ttfts = data.get("errors") or [], data.get("ttfts") or []
        completed = sum(1 for i in range(concurrency)
                        if i < len(ttfts) and ttfts[i] is not None and not (errors[i] if i < len(errors) else None))
        failed = concurrency - completed
        valid, reason = validate(delta, completed, concurrency)
        source = source_name(delta)
        if not valid:
            invalid.append((concurrency, batch, reason))
        local, external = delta["local"], delta["external"]
        validation_rows.append([
            concurrency, batch, completed, failed,
            local["queries"] if local else "", local["hits"] if local else "", rate(local["rate"] if local else None),
            external["queries"] if external else "", external["hits"] if external else "", rate(external["rate"] if external else None),
            source, "yes" if valid else "no", reason, reset_evidence,
        ])
        inputs, outputs = data.get("input_lens") or [], data.get("output_lens") or []
        texts = data.get("generated_texts") or []
        for index in range(concurrency):
            error = errors[index] if index < len(errors) else "missing result"
            ttft = ttfts[index] if index < len(ttfts) else None
            ok = valid and ttft is not None and not error
            raw_rows.append([
                concurrency, batch, index + 1, float(ttft) if ttft is not None else "",
                inputs[index] if index < len(inputs) else "", outputs[index] if index < len(outputs) else "",
                texts[index] if index < len(texts) else "", "yes" if ok else "no", source,
                error or "", filename,
            ])
            if ok:
                valid_values[concurrency].append(float(ttft))
        print(f"c={concurrency:<2} batch={batch}/{BATCHES} source={source:<13} "
              f"local={rate(local['rate'] if local else None):>7} "
              f"external={rate(external['rate'] if external else None):>7} "
              f"{'VALID' if valid else 'EXCLUDED'}")

if STAGE == "R1-warmup" and STORE_SETTLE_SECONDS > 0:
    print(f"Waiting {STORE_SETTLE_SECONDS:g}s for asynchronous Mooncake store...")
    time.sleep(STORE_SETTLE_SECONDS)

previous = {}
if STAGE == "R3-dram-cache":
    path = RUN_DIR / "R2-hbm-cache-summary.json"
    if path.is_file():
        previous = json.loads(path.read_text(encoding="utf-8")).get("concurrencies", {})
summary_rows = [["stage", "concurrency", "valid_requests", "expected_requests", "avg_ttft_seconds",
                 "min_ttft_seconds", "max_ttft_seconds", "vs_R2_change_percent"]]
summary_json = {"stage": STAGE, "created_at": datetime.now(timezone(timedelta(hours=8))).isoformat(),
                "concurrencies": {}}
for concurrency in CONCURRENCIES:
    values = valid_values[concurrency]
    average = statistics.fmean(values) if values else None
    r2_average = (previous.get(str(concurrency)) or {}).get("avg_ttft_seconds")
    change = (average / r2_average - 1) * 100 if average is not None and r2_average else None
    summary_rows.append([STAGE, concurrency, len(values), concurrency * BATCHES,
                         average if average is not None else "", min(values) if values else "",
                         max(values) if values else "", change if change is not None else ""])
    summary_json["concurrencies"][str(concurrency)] = {
        "valid_requests": len(values), "expected_requests": concurrency * BATCHES,
        "avg_ttft_seconds": average, "min_ttft_seconds": min(values) if values else None,
        "max_ttft_seconds": max(values) if values else None, "vs_R2_change_percent": change,
    }

summary_path = RUN_DIR / f"{STAGE}-summary.json"
summary_path.write_text(json.dumps(summary_json, ensure_ascii=False, indent=2), encoding="utf-8")
xlsx_path = RUN_DIR / f"{STAGE}.xlsx"
write_xlsx(xlsx_path, {"summary": summary_rows, STAGE: raw_rows, "validation": validation_rows})
print(f"Result: {xlsx_path}")
print(f"Summary: {summary_path}")
if invalid:
    print(f"Excluded batches: {len(invalid)}")
    for concurrency, batch, reason in invalid:
        print(f"  c={concurrency} batch={batch}: {reason}")
    if STRICT:
        sys.exit(2)
PY
