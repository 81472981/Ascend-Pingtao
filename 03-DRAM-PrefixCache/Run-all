            body = response.read().decode('utf-8', 'replace').strip()
            if response.status != 200 or body.lower() in ('false', '0'):
                raise RuntimeError(f'HTTP {response.status}: {body}')
    except Exception as error:
        raise RuntimeError('local cache reset failed; start vLLM with VLLM_SERVER_DEV_MODE=1') from error
    after = mooncake_keys()
    if before is not None and after != before:
        raise RuntimeError(f'Mooncake Keys changed during {label}: {before} -> {after}')
    return f'{label}: HTTP 200; Mooncake Keys {before} -> {after}'

def wait_mooncake_settle(keys_before):
    deadline = time.monotonic() + STORE_TIMEOUT_SECONDS
    last_keys = None
    stable_since = None
    while time.monotonic() < deadline:
        current = mooncake_keys()
        grew = current is not None and (keys_before is None or current > keys_before)
        if grew and current == last_keys:
            if stable_since is None:
                stable_since = time.monotonic()
            if time.monotonic() - stable_since >= STORE_STABLE_SECONDS:
                return current
        else:
            stable_since = None
        last_keys = current
        time.sleep(0.5)
    raise RuntimeError(f'Mooncake store did not become stable within {STORE_TIMEOUT_SECONDS:g}s; Keys {keys_before} -> {last_keys}')

def completion_prompt(body):
    try:
        data = json.loads(body.decode('utf-8'))
    except Exception:
        return ''
    prompt = data.get('prompt') if isinstance(data, dict) else None
    if isinstance(prompt, str):
        return prompt
    if isinstance(prompt, list):
        return json.dumps(prompt, ensure_ascii=False, separators=(',', ':'))
    return ''

class CaptureProxyHandler(http.server.BaseHTTPRequestHandler):
    protocol_version = 'HTTP/1.1'

    def log_message(self, fmt, *args):
        pass

    def _handle(self):
        length = int(self.headers.get('Content-Length', '0') or 0)
        request_body = self.rfile.read(length) if length else b''
        path = self.path.split('?', 1)[0]
        request_id = self.headers.get('x-request-id', '')
        record = None
        if self.command == 'POST' and path.endswith('/v1/completions'):
            with CAPTURE_LOCK:
                if CAPTURE_PREFIX:
                    capture_index = len(CAPTURE_RECORDS)
                    request_id = request_id or f'{CAPTURE_PREFIX}{capture_index}'
                    record = {'request_id': request_id, 'capture_index': capture_index, 'prompt': completion_prompt(request_body), 'status': None, 'error': ''}
                    CAPTURE_RECORDS.append(record)
        connection = http.client.HTTPConnection(HOST, PORT, timeout=1800)
        headers = {}
        for key, value in self.headers.items():
            if key.lower() in ('host', 'content-length', 'connection', 'accept-encoding'):
                continue
            headers[key] = value
        if record is not None:
            headers['x-request-id'] = record['request_id']
        headers['Host'] = f'{HOST}:{PORT}'
        try:
            connection.request(self.command, self.path, body=request_body, headers=headers)
            upstream = connection.getresponse()
            self.send_response(upstream.status)
            for key, value in upstream.getheaders():
                if key.lower() in ('content-length', 'transfer-encoding', 'connection', 'keep-alive'):
                    continue
                self.send_header(key, value)
            self.send_header('Connection', 'close')
            self.end_headers()
            while True:
                chunk = upstream.read1(65536)
                if not chunk:
                    break
                self.wfile.write(chunk)
                self.wfile.flush()
            self.close_connection = True
            if record is not None:
                record['status'] = upstream.status
        except Exception as error:
            if record is not None:
                record['status'] = 502
                record['error'] = str(error)
            try:
                self.send_response(502)
                self.send_header('Connection', 'close')
                self.end_headers()
                self.wfile.write(str(error).encode('utf-8', 'replace'))
            except Exception:
                pass
        finally:
            connection.close()

    def do_GET(self):
        self._handle()

    def do_POST(self):
        self._handle()

def start_capture_proxy():
    global BENCH_HOST, BENCH_PORT
    server = http.server.ThreadingHTTPServer(('127.0.0.1', 0), CaptureProxyHandler)
    threading.Thread(target=server.serve_forever, daemon=True).start()
    BENCH_HOST = '127.0.0.1'
    BENCH_PORT = server.server_address[1]
    return server

def begin_capture(prefix):
    global CAPTURE_PREFIX
    with CAPTURE_LOCK:
        CAPTURE_RECORDS.clear()
        CAPTURE_PREFIX = prefix

def captured_prompts(prefix, expected):
    with CAPTURE_LOCK:
        records = [dict(item) for item in CAPTURE_RECORDS]
    if len(records) != expected:
        observed = [record['request_id'] or '<missing>' for record in records]
        raise RuntimeError(f'captured {len(records)}/{expected} completion requests; x-request-id={observed}')
    indexed = []
    for record in records:
        request_id = record['request_id']
        suffix = request_id[len(prefix):] if request_id.startswith(prefix) else ''
        if not suffix.isdigit():
            indexed = []
            break
        indexed.append((int(suffix), record))
    if indexed and len({item[0] for item in indexed}) == expected:
        indexed.sort(key=lambda item: item[0])
        records = [item[1] for item in indexed]
        mode = 'x-request-id'
    else:
        records.sort(key=lambda item: item['capture_index'])
        mode = 'proxy-arrival-order'
    for index, record in enumerate(records):
        record['request_id'] = record['request_id'] or f'{prefix}{index}'
        record['capture_mode'] = mode
    return records

def prompt_sha(prompt):
    return hashlib.sha256(prompt.encode('utf-8')).hexdigest()

def token_sha(tokens):
    raw = json.dumps(tokens, separators=(',', ':')).encode('ascii')
    return hashlib.sha256(raw).hexdigest()

def tokenize_prompt(prompt):
    status, data = post_json(f'http://{HOST}:{PORT}/tokenize', {'model': SERVED_MODEL_NAME, 'prompt': prompt, 'add_special_tokens': False}, timeout=300)
    tokens = data.get('tokens') if isinstance(data, dict) else None
    if status != 200 or not isinstance(tokens, list):
        raise RuntimeError('/tokenize did not return a token list')
    return tokens

def seed_for(batch):
    return BASE_SEED + CONCURRENCY * 10000 + batch

def benchmark_command(vllm, stage, batch, seed, filename, request_prefix):
