def metric_sum(text, name):
    values = []
    for line in text.splitlines():
        fields = line.split()
        if len(fields) >= 2 and fields[0].split('{', 1)[0] == name:
            try:
                values.append(float(fields[1]))
            except ValueError:
                pass
    return sum(values) if values else None

def cache_metrics():
    try:
        text = fetch(f'http://{HOST}:{PORT}/metrics')
    except Exception:
        return {name: None for name in CACHE_PAIRS}
    result = {}
    for label, pairs in CACHE_PAIRS.items():
        result[label] = None
        for query_name, hit_name in pairs:
            queries = metric_sum(text, query_name)
            hits = metric_sum(text, hit_name)
            if queries is not None and hits is not None:
                result[label] = (queries, hits)
                break
    return result

def cache_delta(before, after):
    result = {}
    for label in CACHE_PAIRS:
        first, last = (before.get(label), after.get(label))
        if first is None or last is None:
            result[label] = None
            continue
        queries = last[0] - first[0]
        hits = last[1] - first[1]
        result[label] = {'queries': queries, 'hits': hits, 'rate': hits / queries if queries > 0 else None}
    return result

def rate_text(value):
    return f'{value:.2%}' if value is not None else 'N/A'

def mooncake_summary():
