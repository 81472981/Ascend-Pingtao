def col_name(index):
    name = ''
    while index >= 0:
        name = chr(65 + index % 26) + name
        index = index // 26 - 1
    return name

def sheet_xml(rows):
    body = []
    for row_number, row in enumerate(rows, 1):
        cells = []
        for column_number, value in enumerate(row):
            reference = f'{col_name(column_number)}{row_number}'
            if isinstance(value, (int, float)) and (not isinstance(value, bool)):
                cells.append(f'<c r="{reference}"><v>{value}</v></c>')
            else:
                text = escape(XML_INVALID.sub('', str(value)))
                cells.append(f'<c r="{reference}" t="inlineStr"><is><t>{text}</t></is></c>')
        body.append(f'''<row r="{row_number}">{''.join(cells)}</row>''')
    last_column = col_name(max((len(row) for row in rows), default=1) - 1)
    last_row = max(len(rows), 1)
    return f"""<?xml version="1.0" encoding="UTF-8" standalone="yes"?><worksheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main"><dimension ref="A1:{last_column}{last_row}"/><sheetData>{''.join(body)}</sheetData></worksheet>"""

def write_xlsx(path, sheets):
    content = '<?xml version="1.0" encoding="UTF-8" standalone="yes"?><Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types"><Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/><Default Extension="xml" ContentType="application/xml"/><Override PartName="/xl/workbook.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml"/>'
    relationships = '<?xml version="1.0" encoding="UTF-8" standalone="yes"?><Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">'
    sheet_tags = ''
    for index, name in enumerate(sheets, 1):
        content += f'<Override PartName="/xl/worksheets/sheet{index}.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml"/>'
        relationships += f'<Relationship Id="rId{index}" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/worksheet" Target="worksheets/sheet{index}.xml"/>'
        sheet_tags += f'<sheet name="{escape(name)}" sheetId="{index}" r:id="rId{index}"/>'
    content += '</Types>'
    relationships += '</Relationships>'
    workbook = f'<?xml version="1.0" encoding="UTF-8" standalone="yes"?><workbook xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships"><sheets>{sheet_tags}</sheets></workbook>'
    root_relationships = '<?xml version="1.0" encoding="UTF-8" standalone="yes"?><Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships"><Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument" Target="xl/workbook.xml"/></Relationships>'
    with zipfile.ZipFile(path, 'w', zipfile.ZIP_DEFLATED) as archive:
        archive.writestr('[Content_Types].xml', content)
        archive.writestr('_rels/.rels', root_relationships)
        archive.writestr('xl/workbook.xml', workbook)
        archive.writestr('xl/_rels/workbook.xml.rels', relationships)
        for index, rows in enumerate(sheets.values(), 1):
            archive.writestr(f'xl/worksheets/sheet{index}.xml', sheet_xml(rows))

def percent_change(current, baseline):
    if current is None or baseline in (None, 0):
        return ''
    return (current / baseline - 1) * 100

def completed_payloads():
    payloads = {}
    for path in RUN_DIR.glob('C*-result.json'):
        try:
            payload = json.loads(path.read_text(encoding='utf-8'))
            payloads[int(payload['concurrency'])] = payload
        except Exception as error:
            raise RuntimeError(f'invalid result file {path}: {error}') from error
    return dict(sorted(payloads.items()))

def rebuild_workbook():
    payloads = completed_payloads()
    summary = [['stage', 'concurrency', 'successful_requests', 'total_requests', 'success_rate_percent', 'ttft_samples', 'avg_ttft_seconds', 'min_ttft_seconds', 'max_ttft_seconds']]
    stage_sheets = {stage: [RAW_HEADER] for stage in STAGES}
    validation = [VALIDATION_HEADER]
    for concurrency, payload in payloads.items():
        summary.extend(payload['summary_rows'])
        for stage in STAGES:
            stage_sheets[stage].extend(payload['stage_rows'].get(stage, []))
        validation.extend(payload['validation_rows'])
    manifest = load_manifest()
    manifest_rows = [['prompt_id', 'concurrency', 'batch', 'request_index', 'seed', 'input_tokens', 'prompt_sha256', 'token_sha256', 'first_block_sha256']]
    manifest_rows.extend(([item['prompt_id'], item['concurrency'], item['batch'], item['request_index'], item['seed'], item['input_tokens'], item['prompt_sha256'], item['token_sha256'], item['first_block_sha256']] for item in sorted(manifest['requests'].values(), key=lambda value: (value['concurrency'], value['batch'], value['request_index']))))
    analysis = [['concurrency', 'R1_avg_ttft_seconds', 'R1_success_rate_percent', 'R2_avg_ttft_seconds', 'R2_success_rate_percent', 'R3_avg_ttft_seconds', 'R3_success_rate_percent', 'R2_vs_R1_change_percent', 'R3_vs_R2_change_percent', 'R3_vs_R1_change_percent']]
    for concurrency, payload in payloads.items():
        values = payload['stage_summary']
        r1 = values['R1-warmup']['avg_ttft_seconds']
        r2 = values['R2-hbm-cache']['avg_ttft_seconds']
        r3 = values['R3-dram-cache']['avg_ttft_seconds']
        analysis.append([concurrency, r1 if r1 is not None else '', values['R1-warmup']['success_rate_percent'], r2 if r2 is not None else '', values['R2-hbm-cache']['success_rate_percent'], r3 if r3 is not None else '', values['R3-dram-cache']['success_rate_percent'], percent_change(r2, r1), percent_change(r3, r2), percent_change(r3, r1)])
    sheets = {'summary': summary, 'TTFT-analysis': analysis, **stage_sheets}
    sheets['validation'] = validation
    sheets['P1-manifest'] = manifest_rows
    write_xlsx(WORKBOOK_PATH, sheets)

def build_payload(stage_rows, validation_rows):
    summary_rows = []
    stage_summary = {}
    for stage in STAGES:
        values = [float(row[6]) for row in stage_rows[stage] if row[14] == 'yes' and row[6] != '']
        total = CONCURRENCY * BATCHES
        successful = sum((1 for row in stage_rows[stage] if row[6] != '' and (not row[15])))
        item = {'successful_requests': successful, 'total_requests': total, 'success_rate_percent': successful / total * 100 if total else 0, 'ttft_samples': len(values), 'avg_ttft_seconds': statistics.fmean(values) if values else None, 'min_ttft_seconds': min(values) if values else None, 'max_ttft_seconds': max(values) if values else None}
        stage_summary[stage] = item
        summary_rows.append([stage, CONCURRENCY, item['successful_requests'], item['total_requests'], item['success_rate_percent'], item['ttft_samples'], item['avg_ttft_seconds'] if item['avg_ttft_seconds'] is not None else '', item['min_ttft_seconds'] if item['min_ttft_seconds'] is not None else '', item['max_ttft_seconds'] if item['max_ttft_seconds'] is not None else ''])
    return {'created_at': now_cn(), 'concurrency': CONCURRENCY, 'batches': BATCHES, 'input_tokens': INPUT_LEN, 'block_size': BLOCK_SIZE, 'stage_rows': stage_rows, 'validation_rows': validation_rows, 'summary_rows': summary_rows, 'stage_summary': stage_summary}

def clear_generated_session():
    if JSON_DIR.parent.is_dir():
        shutil.rmtree(JSON_DIR.parent)
    for path in RUN_DIR.glob('C*-result.json'):
        path.unlink()
    for path in (SESSION_PATH, MANIFEST_PATH, PROMPTS_PATH, WORKBOOK_PATH):
        path.unlink(missing_ok=True)

def prepare_session():
    RUN_DIR.mkdir(parents=True, exist_ok=True)
    keys = mooncake_keys()
    if keys is None and STRICT:
        sys.exit(f'cannot read Mooncake Keys from {MOONCAKE_URL}')
    if NEW_SESSION:
        if keys not in (None, 0):
            sys.exit(f'new session requires empty Mooncake, but Keys={keys}; restart vLLM/Mooncake')
        clear_generated_session()
    if SESSION_PATH.is_file():
        session = json.loads(SESSION_PATH.read_text(encoding='utf-8'))
        if session.get('model') != MODEL or session.get('input_tokens') != INPUT_LEN:
            sys.exit('existing VB_RUN_DIR belongs to a different model/input length')
        if RESULT_PATH.is_file():
            sys.exit(f'{RESULT_PATH} already exists; R1 cannot be repeated cold without restarting vLLM/Mooncake and using a new session')
        if session.get('completed_concurrencies') and keys in (None, 0):
            sys.exit('Mooncake is empty but this session already has results; start a new session')
        return session
    if keys not in (None, 0):
        sys.exit(f'first concurrency requires empty Mooncake, but Keys={keys}; restart vLLM/Mooncake')
    session = {'created_at': now_cn(), 'model': MODEL, 'served_model_name': SERVED_MODEL_NAME, 'input_tokens': INPUT_LEN, 'block_size': BLOCK_SIZE, 'batches': BATCHES, 'expected_concurrencies': EXPECTED_CONCURRENCIES, 'completed_concurrencies': []}
    SESSION_PATH.write_text(json.dumps(session, ensure_ascii=False, indent=2), encoding='utf-8')
    return session

