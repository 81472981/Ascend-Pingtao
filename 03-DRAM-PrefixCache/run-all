#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
if [[ -z "${VB_RUN_DIR:-}" ]]; then
  result_root="vb-result"
  result_stamp="$(date '+%Y-%m-%d %H-%M-%S')"
  VB_RUN_DIR="$result_root/$result_stamp"
  result_suffix=2
  while [[ -e "$VB_RUN_DIR" ]]; do
    printf -v suffix_text '%02d' "$result_suffix"
    VB_RUN_DIR="$result_root/$result_stamp-$suffix_text"
    ((result_suffix += 1))
  done
fi
export VB_RUN_DIR
export VB_EXPECT_CONCURRENCIES="${VB_EXPECT_CONCURRENCIES:-1,5,10}"

echo "Results from all stages will be written to: $VB_RUN_DIR"
echo "Execution order: C1 -> C5 -> C10; each batch runs R1 -> R2 -> reset HBM -> R3"

VB_NEW_SESSION=1 bash "$SCRIPT_DIR/C1"
VB_NEW_SESSION=0 bash "$SCRIPT_DIR/C5"
VB_NEW_SESSION=0 bash "$SCRIPT_DIR/C10"
